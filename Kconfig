rsource "drivers/Kconfig"
rsource "behaviors/Kconfig"
rsource "input_processors/Kconfig"

config INPUT_IQS9151_STUDIO_RPC
    bool "Enable IQS9151 custom Studio RPC"
    depends on ZMK_STUDIO_RPC
    help
      Enable the IQS9151 custom Studio RPC subsystem using ZMK custom
      Studio RPC. The subsystem identifiers are dya__iqs9151 and
      zmk__iqs9151. If the IQS9151 device is not present in the same
      firmware image, the subsystem is advertised but runtime get/set
      requests return an error.
